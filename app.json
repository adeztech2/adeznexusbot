{
  "name": "ADEZ NEXUS",
  "description": "WhatsApp bot with 250+ commands: group moderation, media tools, games, dev tools, AI chat and more. Fill in 3 fields and deploy.",
  "repository": "https://github.com/adeztech2/baileys",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "nodejs",
    "multi-device",
    "group-management",
    "ai",
    "stickers",
    "downloader"
  ],
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    },
    {
      "url": "heroku/nodejs"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ],
  "env": {
    "SESSION_ID": {
      "description": "Your WhatsApp session ID (starts with ADEZ~)",
      "required": true
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number with country code, digits only (no +)",
      "required": true
    },
    "PREFIX": {
      "description": "Bot command prefix",
      "value": ".",
      "required": true
    }
  }
}
